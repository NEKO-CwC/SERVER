# Copy to .env, fill only the values you need, chmod 600 .env.
# Agent/client/server: bash <install.sh> --env .env
# Other commands: bash with-proxy.sh --env .env -- COMMAND [ARG...]
# Installers default to interactive proxy input; --env reads these variables.
# Scripts never load a file from the current directory automatically.

# cc-switch configuration source: dav (default) or sql.
CC_SWITCH_CONFIG_SOURCE=dav
# Required only when CC_SWITCH_CONFIG_SOURCE=sql.
CC_SWITCH_SQL_FILE=
# Required for DAV; unnecessary with --sql-file or --skip-config.
CC_SWITCH_WEBDAV_BASE_URL=
CC_SWITCH_WEBDAV_USERNAME=
CC_SWITCH_WEBDAV_PASSWORD=
CC_SWITCH_WEBDAV_REMOTE_ROOT=cc-switch-sync
CC_SWITCH_WEBDAV_PROFILE=default
# Shared by Agent, sing-box client/server and with-proxy.sh.
# Legacy AGENT_PROXY_* / AGENT_SSH_* variables are accepted if INSTALL_* is unset/empty.
# env: INSTALL_PROXY_URL overrides HTTP/HTTPS/ALL_PROXY; empty preserves shell env.
# ssh: start a temporary SSH SOCKS tunnel only when installation needs the network.
INSTALL_PROXY_MODE=env
INSTALL_PROXY_URL=
INSTALL_SSH_HOST=
INSTALL_SSH_USER=
INSTALL_SSH_PASSWORD=
INSTALL_SSH_PORT=22
INSTALL_SSH_SOCKS_PORT=1080
# no: password only, do not check or save server host keys (default).
# accept-new: automatically save first key; reject changed keys.
# yes: require an already trusted host key.
INSTALL_SSH_HOST_KEY_CHECKING=no
# Optional file for accept-new/yes. Ignored with no; otherwise defaults to OpenSSH.
INSTALL_SSH_KNOWN_HOSTS_FILE=

# Client: Xboard URL returning a complete sing-box config for User-Agent sing-box.
SUBSCRIPTION_URL=

# Server: set ONE of these; remote content must be a complete server config.
SINGBOX_SERVER_CONFIG_FILE=
SINGBOX_SERVER_CONFIG_URL=

# Legacy binary-only proxy for sing-box in --env mode. Prefer INSTALL_* above.
# Used only with mode=env and no explicit INSTALL_PROXY_URL/AGENT_PROXY_URL.
DOWNLOAD_PROXY=
# Optional version override (defaults: client 1.13.15, server 1.13.13).
# SINGBOX_VERSION=

# Optional API DNS rescue.
AGENT_API_HOST=
AGENT_API_IP=

# Only for OS reinstallation (VPS/DD.sh).
VPS_ROOT_PASSWORD=
VPS_SSH_PUBLIC_KEY=

# Optional local Caddy reverse proxy.
SITE_ADDRESS=
UPSTREAM_ADDRESS=
